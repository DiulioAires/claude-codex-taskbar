# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,markdown}]
# Trailing double spaces can be meaningful line breaks in Markdown.
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{ps1,psm1,psd1,cmd,bat}]
end_of_line = crlf

[*.{sln,vcxproj,rc}]
end_of_line = crlf
